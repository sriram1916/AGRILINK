{
  "version": 1,
  "serialMonitor": {
    "display": "always",
    "convertEol": true
  },
  "author": "AgriLink",
  "title": "AgriLink ESP32 Vehicle ECU - Phase 2 Simulation",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp32",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 50,
      "left": 250,
      "attrs": {
        "color": "green"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 150,
      "left": 250,
      "attrs": {
        "color": "red"
      }
    }
  ],
  "connections": [
    [ "esp32:2", "led1:A", "", [] ],
    [ "led1:C", "esp32:GND.3", "", [] ],
    [ "esp32:0", "btn1:1.l", "", [] ],
    [ "btn1:2.r", "esp32:GND.3", "", [] ],
    [ "esp32:TX", "$serialMonitor:RX", "", [] ],
    [ "esp32:RX", "$serialMonitor:TX", "", [] ]
  ],
  "dependencies": {}
}
